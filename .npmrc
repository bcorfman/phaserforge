; Note: Production installs should use `npm ci --omit=dev` (or equivalent)
; in the deployment environment. We keep devDependencies enabled in this repo
; so local development and CI (Vitest/Playwright/Vite) work by default.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
